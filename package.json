{
  "name": "sabidex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sabidex — app de estudo gamificado: estude, ganhe pacotes de cartas e complete o álbum.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
