{
  // Sabidex — hospedado na Cloudflare.
  // O app (arquivos estáticos) e o servidor (/api) rodam no mesmo Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabidex",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público do app: https://sabidex.com.br
  // (sabidex.com e os "www" redirecionam para ele; o código está em src/worker/index.ts).
  // O endereço antigo https://sabidex.fastlabs.workers.dev continua funcionando.
  // Os domínios precisam estar na mesma conta da Cloudflare deste Worker.
  "routes": [
    { "pattern": "sabidex.com.br", "custom_domain": true },
    { "pattern": "www.sabidex.com.br", "custom_domain": true }
    // Quando o sabidex.com estiver ativo na Cloudflare, acrescentar:
    // { "pattern": "sabidex.com", "custom_domain": true },
    // { "pattern": "www.sabidex.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // O servidor olha todo pedido primeiro, para redirecionar os outros domínios.
    "run_worker_first": true
  },
  // Banco de dados das turmas. Sem "database_id": a Cloudflare cria sozinha no primeiro deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "sabidex" }],
  // Mantém as variáveis criadas no painel (GOOGLE_CLIENT_ID, APPLE_CLIENT_ID, EMAIL_REMETENTE)
  // quando a Cloudflare publica uma versão nova.
  "keep_vars": true,
  "vars": {
    // Quem vê todas as turmas (administrador geral).
    "ADMIN_EMAILS": "lucasrpanzarin@gmail.com,lucas@fastgsa.com",
    // Remetente do e-mail de "Esqueci minha senha" (a chave RESEND_API_KEY fica como segredo no painel).
    "EMAIL_REMETENTE": "Sabidex <nao-responda@sabidex.com.br>"
  },
  "observability": { "enabled": true },
  // Versões de teste de cada pull request (comando "wrangler preview" da Cloudflare).
  // De propósito SEM o banco de dados: a prévia nunca lê nem grava dados reais das turmas.
  // O jogo funciona normalmente na prévia; só as partes de turma (login, trocas, ranking) ficam sem servidor.
  "previews": {
    "vars": {
      "ADMIN_EMAILS": "lucasrpanzarin@gmail.com,lucas@fastgsa.com",
    // Remetente do e-mail de "Esqueci minha senha" (a chave RESEND_API_KEY fica como segredo no painel).
    "EMAIL_REMETENTE": "Sabidex <nao-responda@sabidex.com.br>"
    }
  }
}
