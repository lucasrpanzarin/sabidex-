{
  // Sabidex — hospedado na Cloudflare.
  // O app (arquivos estáticos) e o servidor (/api) rodam no mesmo Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabidex",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público do app: https://sabidex.fastlabs.workers.dev
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Banco de dados das turmas. Sem "database_id": a Cloudflare cria sozinha no primeiro deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "sabidex" }],
  "vars": {
    // Quem vê todas as turmas (administrador geral).
    "ADMIN_EMAILS": "lucasrpanzarin@gmail.com,lucas@fastgsa.com"
  },
  "observability": { "enabled": true }
}
